    { "path": "cap_left_plan_set", "type": "string" },
    { "path": "cap_both_plan_set", "type": "string" },
    { "path": "slope1_left_plan_set", "type": "string" },
    { "path": "slope1_right_plan_set", "type": "string" },
    { "path": "slope2_left_plan_set", "type": "string" },
    { "path": "slope2_right_plan_set", "type": "string" },
    { "path": "slope3_left_plan_set", "type": "string" },
    { "path": "slope3_right_plan_set", "type": "string" },
    { "path": "wall_spawn", "type": "boolean" },
    { "path": "tower_spawn", "type": "boolean" },
